# Victor AI — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL / pgvector (Mem0 backing store)
# ---------------------------------------------------------------------------
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=victor
PGVECTOR_USER=victor
PGVECTOR_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Ollama (local LLM server)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Model profiles (override to use different Ollama models per tier)
COMPUTE_MODEL_FAST=phi3
COMPUTE_MODEL_BALANCED=llama3
COMPUTE_MODEL_HEAVY=llama3:70b
COMPUTE_MODEL_CODE=codellama

# Model used by the LangGraph agent executor
AGENT_MODEL=llama3

# Models used by Mem0 for fact extraction and embedding
MEMORY_LLM_MODEL=llama3
MEMORY_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Home Assistant (Symbiotic Bridge)
# ---------------------------------------------------------------------------
HA_WS_URL=ws://localhost:8123/api/websocket
# Generate a long-lived token in your HA profile:
# Settings → Profile → Long-Lived Access Tokens → Create Token
HA_LONG_LIVED_TOKEN=

# ---------------------------------------------------------------------------
# SMTP (send_email tool)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
